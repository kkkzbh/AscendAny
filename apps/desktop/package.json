{
  "name": "@ascendany/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AscendAny desktop application",
  "homepage": "https://github.com/kkkzbh/AscendAny",
  "author": {
    "name": "AscendAny Team",
    "email": "opensource@ascendany.dev"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist:win:x64": "pnpm run build && electron-builder --win nsis --x64",
    "dist:linux:rpm:x64": "pnpm run build && electron-builder --linux rpm --x64",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.ascendany.desktop",
    "productName": "AscendAny",
    "artifactName": "AscendAny-${os}-${arch}-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "AscendAny Team <opensource@ascendany.dev>",
      "category": "Utility"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
