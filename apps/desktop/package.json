{
  "name": "@ascendany/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AscendAny desktop application",
  "homepage": "https://github.com/kkkzbh/AscendAny",
  "author": {
    "name": "AscendAny Team",
    "email": "opensource@ascendany.dev"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "web:dev": "vite --config vite.web.config.ts --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b && node scripts/check-typecheck-clean.mjs",
    "build": "pnpm run typecheck && vite build",
    "web:build": "pnpm run typecheck && vite build --config vite.web.config.ts",
    "test": "pnpm run test:unit && pnpm run test:electron",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vitest.electron.config.ts",
    "test:release-scripts": "bash scripts/tests/release-builders-fixture.sh",
    "rebuild:native": "electron-rebuild --version $(node -p \"require('electron/package.json').version\") --module-dir . --which-module better-sqlite3 --force",
    "postinstall": "pnpm run rebuild:native",
    "preview": "vite preview",
    "web:preview": "vite preview --config vite.web.config.ts --host 0.0.0.0 --port 4173"
  },
  "build": {
    "appId": "com.ascendany.desktop",
    "productName": "AscendAny",
    "artifactName": "AscendAny-${os}-${arch}-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://ascendany.kkkzbh.cn/desktop-updates"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "resources/icons",
      "executableName": "ascendany",
      "target": [
        {
          "target": "rpm",
          "arch": ["x64"]
        }
      ],
      "maintainer": "AscendAny Team <opensource@ascendany.dev>",
      "category": "Utility",
      "desktop": {
        "Name": "AscendAny",
        "StartupWMClass": "ascendany",
        "X-GNOME-WMClass": "ascendany"
      }
    }
  },
  "dependencies": {
    "@ascendany/sdk": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^3.2.0"
  }
}
