# 浏览器直接访问 API 时填写规范化 Origin；同源部署时留空。
# 只接受无路径、查询参数和尾部斜杠的 HTTPS Origin，loopback HTTP 也可用于本地开发。
VITE_API_BASE_URL=

# 本地 Vite 同源代理的目标，仅由开发服务器读取。
VITE_API_PROXY_TARGET=http://127.0.0.1:18000

# 学习助手只接受后端已经发布的 canonical configuration key；缺失时发送功能直接停用。
VITE_CHAT_PROMPT_CONFIGURATION_KEY=agent.prompt.default
VITE_CHAT_MODEL_CONFIGURATION_KEY=agent.model.default
