[Unit]
Description=AscendAny API
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/opt/ascendany/Release
EnvironmentFile=/etc/ascendany/api.env
ExecStart=/opt/ascendany/.venv/bin/python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
