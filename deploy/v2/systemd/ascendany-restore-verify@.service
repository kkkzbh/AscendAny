[Unit]
Description=Destructively verify AscendAny backup %i in an isolated scratch database
Documentation=file:/opt/ascendany/v2/README.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/backups/ascendany /var/lib/ascendany-restore /var/lib/ascendany-acceptance
AssertFileIsExecutable=/opt/ascendany/v2/bin/ascendany-backup
AssertFileIsExecutable=/opt/ascendany/v2/scripts/restore-verify-operator.sh
AssertFileIsExecutable=/opt/ascendany/v2/scripts/publish-restore-evidence.sh
AssertPathExists=/etc/ascendany/v2/restore.env
AssertPathIsDirectory=/var/backups/ascendany
AssertPathIsDirectory=/var/lib/ascendany-restore

[Service]
Type=oneshot
User=ascendany-restore
Group=ascendany-restore
SupplementaryGroups=ascendany-backup-readers
WorkingDirectory=/var/lib/ascendany-restore
UMask=0077

LoadCredentialEncrypted=restore_db_password:/etc/ascendany/credentials/restore_db_password.cred
EnvironmentFile=/etc/ascendany/v2/restore.env
Environment=ASCENDANY_RESTORE_DATABASE_PASSWORD_FILE=%d/restore_db_password
Environment=ASCENDANY_RESTORE_RUNTIME_ROOT=%t/ascendany-restore-verify-%i
ExecStartPre=/usr/bin/test -s %d/restore_db_password
ExecStartPre=/usr/bin/test -f /run/ascendany-restore-operator/operator.lock
ExecStartPre=/usr/bin/test -f /run/ascendany-restore-operator/publication.lock
ExecStart=/opt/ascendany/v2/scripts/restore-verify-operator.sh run %i
ExecStartPost=+/opt/ascendany/v2/scripts/publish-restore-evidence.sh %i
TimeoutStartSec=2h5m

RuntimeDirectory=ascendany-restore-verify-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.88.0.2/32
ReadOnlyPaths=/etc/ascendany/v2 /var/backups/ascendany
ReadWritePaths=/var/lib/ascendany-restore /var/lib/ascendany-acceptance /run/ascendany-restore-operator /run/ascendany-restore-verify-%i
InaccessiblePaths=/var/lib/ascendany/artifacts /var/lib/ascendany-catalog-publisher
