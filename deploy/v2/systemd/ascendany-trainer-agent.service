[Unit]
Description=AscendAny v2 recommendation trainer agent
Documentation=file:/opt/ascendany/v2/README.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/ascendany/Release /opt/ascendany-trainer-runtime/current /var/lib/ascendany-trainer/work /var/lib/ascendany-trainer/acceptance
AssertFileIsExecutable=/opt/ascendany/v2/bin/ascendany-trainer-agent
AssertFileIsExecutable=/usr/bin/bwrap
AssertFileIsExecutable=/opt/ascendany-trainer-runtime/current/python/bin/python3.14
AssertPathIsDirectory=/opt/ascendany/Release
AssertPathIsDirectory=/opt/ascendany/v2/trainers/recommendation
AssertPathExists=/etc/ascendany/v2/trainer-agent.env
AssertPathIsDirectory=/var/lib/ascendany-trainer/acceptance

[Service]
Type=exec
User=ascendany-trainer
Group=ascendany-trainer
WorkingDirectory=/var/lib/ascendany-trainer
UMask=0077

# This scoped HTTPS credential is owned by the Go supervisor. The bubblewrap
# child receives a cleared, fixed environment and cannot see %d or the network.
LoadCredentialEncrypted=trainer_agent_token:/etc/ascendany/credentials/trainer_agent_token.cred
EnvironmentFile=/etc/ascendany/v2/trainer-agent.env
Environment=ASCENDANY_TRAINER_AGENT_TOKEN_FILE=%d/trainer_agent_token
ExecStartPre=/usr/bin/test -s %d/trainer_agent_token
ExecStartPre=/usr/bin/test -c /dev/nvidia0
ExecStartPre=/usr/bin/test -c /dev/nvidiactl
ExecStartPre=/usr/bin/test -c /dev/nvidia-uvm
ExecStartPre=/opt/ascendany/v2/bin/ascendany-trainer-agent verify-runtime
ExecStart=/opt/ascendany/v2/bin/ascendany-trainer-agent run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillMode=mixed
OOMPolicy=kill

StateDirectory=ascendany-trainer
StateDirectoryMode=0700
LogsDirectory=ascendany-trainer
LogsDirectoryMode=0750

# bubblewrap requires user and mount namespaces. RestrictNamespaces and
# PrivateUsers are intentionally omitted. DevicePolicy exposes only the exact
# NVIDIA character devices that the child adapter also enumerates.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
SystemCallArchitectures=native
SystemCallFilter=~@clock
ReadOnlyPaths=/etc/ascendany/v2 /opt/ascendany-trainer-runtime /opt/ascendany/v2/trainers/recommendation
ReadWritePaths=/var/lib/ascendany-trainer
InaccessiblePaths=/etc/ascendany/credentials /opt/ascendany/Release /var/lib/ascendany/artifacts
TasksMax=512
MemoryHigh=20G
MemoryMax=24G
CPUQuota=800%

[Install]
WantedBy=multi-user.target
