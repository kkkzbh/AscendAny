[Unit]
Description=AscendAny v2 Go backend
Documentation=file:/opt/ascendany/v2/README.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/ascendany/artifacts
AssertFileIsExecutable=/opt/ascendany/v2/bin/ascendanyd
AssertFileIsExecutable=/opt/ascendany/v2/bin/ascendany-model
AssertPathExists=/opt/ascendany/v2/models/recommendation-model.json
AssertPathExists=/opt/ascendany/v2/models/recommendation-knowledge-catalog.json
AssertPathExists=/etc/ascendany/v2/ascendanyd.env

[Service]
Type=exec
User=ascendany
Group=ascendany
SupplementaryGroups=ascendany-runtime ascendany-lsp-control
WorkingDirectory=/var/lib/ascendany
# Runtime-created artifact directories are opened with O_NOFOLLOW and fchmod'd
# to the store's exact 0750/0700 contract after their initially private create.
UMask=0077

# Binary contract: ascendanyd reads every secret through the *_FILE
# variables and refuses startup when a required credential is empty.
LoadCredentialEncrypted=db_password:/etc/ascendany/credentials/runtime_db_password.cred
LoadCredentialEncrypted=jwt_signing_private_key:/etc/ascendany/credentials/jwt_signing_private_key.cred
LoadCredentialEncrypted=password_pepper:/etc/ascendany/credentials/password_pepper.cred
EnvironmentFile=/etc/ascendany/v2/ascendanyd.env
Environment=SHELL=/usr/sbin/nologin
Environment=ASCENDANY_DATABASE_PASSWORD_FILE=%d/db_password
Environment=ASCENDANY_JWT_SIGNING_PRIVATE_KEY_FILE=%d/jwt_signing_private_key
Environment=ASCENDANY_PASSWORD_PEPPER_FILE=%d/password_pepper
ExecStartPre=/usr/bin/test -s %d/db_password
ExecStartPre=/usr/bin/test -s %d/jwt_signing_private_key
ExecStartPre=/usr/bin/test -s %d/password_pepper
ExecStartPre=/opt/ascendany/v2/bin/ascendany-model verify-catalog --catalog /opt/ascendany/v2/models/recommendation-knowledge-catalog.json --catalog-sha256 ${ASCENDANY_KNOWLEDGE_CATALOG_SHA256} --model /opt/ascendany/v2/models/recommendation-model.json --model-sha256 ${ASCENDANY_RECOMMENDATION_MODEL_SHA256} --expected-purpose ${ASCENDANY_RECOMMENDATION_MODEL_PURPOSE}
ExecStart=/opt/ascendany/v2/bin/ascendanyd serve
Restart=on-failure
RestartSec=3s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
# Pin the JOURNAL_STREAM and systemd PSI process-environment sources used by
# production acceptance.
StandardOutput=journal
StandardError=journal
MemoryPressureWatch=yes
MemoryPressureThresholdSec=200ms

RuntimeDirectory=ascendany
RuntimeDirectoryMode=0750
StateDirectory=ascendany
StateDirectoryMode=0750
LogsDirectory=ascendany
LogsDirectoryMode=0750

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/ascendany/v2
ReadWritePaths=/var/lib/ascendany /run/ascendany /run/ascendany-lsp-control
InaccessiblePaths=/opt/ascendany/Release /var/lib/ascendany-catalog-publisher

[Install]
WantedBy=multi-user.target
