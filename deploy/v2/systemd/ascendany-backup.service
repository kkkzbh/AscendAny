[Unit]
Description=AscendAny v2 database and artifact backup
Documentation=file:/opt/ascendany/v2/README.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/ascendany/artifacts /var/lib/ascendany-catalog-publisher/receipts /var/backups/ascendany
AssertFileIsExecutable=/opt/ascendany/v2/bin/ascendany-backup
AssertPathExists=/etc/ascendany/v2/backup.env
AssertPathIsDirectory=/var/lib/ascendany-catalog-publisher/receipts

[Service]
Type=oneshot
User=ascendany-backup
Group=ascendany-backup-readers
SupplementaryGroups=ascendany ascendany-catalog-readers
WorkingDirectory=/var/backups/ascendany
UMask=0077

# Binary contract: create emits a PostgreSQL custom-format dump, checksummed
# artifact and catalog-publication-receipt snapshots, and one binding manifest.
LoadCredentialEncrypted=backup_db_password:/etc/ascendany/credentials/backup_db_password.cred
EnvironmentFile=/etc/ascendany/v2/backup.env
Environment=ASCENDANY_DATABASE_PASSWORD_FILE=%d/backup_db_password
Environment=ASCENDANY_BACKUP_RUNTIME_ROOT=/run/ascendany-backup
ExecStartPre=/usr/bin/test -s %d/backup_db_password
ExecStart=/opt/ascendany/v2/bin/ascendany-backup create
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

LogsDirectory=ascendany-backup
LogsDirectoryMode=0700
RuntimeDirectory=ascendany-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.88.0.2/32
ReadOnlyPaths=/etc/ascendany/v2 /var/lib/ascendany/artifacts /var/lib/ascendany-catalog-publisher/receipts
ReadWritePaths=/var/backups/ascendany /run/ascendany-backup
InaccessiblePaths=/opt/ascendany/Release
