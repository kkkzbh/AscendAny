# Non-secret isolated restore-verification configuration. The target database
# must be newly created from template0 and named exactly
# ascendany_v2_restore_verify. Provision all v2 capability roles in the same
# PostgreSQL cluster before running the gate.
# `ascendany-restore-verify@.service` injects the expanded per-instance
# ASCENDANY_RESTORE_RUNTIME_ROOT=/run/ascendany-restore-verify-%i contract.
# EnvironmentFile does not own or expand this systemd instance specifier.
ASCENDANY_BACKUP_ROOT=/var/backups/ascendany
ASCENDANY_BACKUP_FORMAT=pg_custom_plus_artifact_tar_zstd
ASCENDANY_BACKUP_MANIFEST_HASH=sha256
ASCENDANY_RESTORE_DATABASE_URL=postgresql://ascendany_restore_login@127.0.0.1:5432/ascendany_v2_restore_verify
ASCENDANY_RESTORE_ARTIFACT_ROOT=/var/lib/ascendany-restore/artifacts
ASCENDANY_DATABASE_CONNECT_TIMEOUT=5s
ASCENDANY_BACKUP_COMMAND_TIMEOUT=2h
ASCENDANY_PG_DUMP_PATH=/usr/bin/pg_dump
ASCENDANY_PG_RESTORE_PATH=/usr/bin/pg_restore
ASCENDANY_ZSTD_PATH=/usr/bin/zstd

# Supply this path only at invocation time or through a separate encrypted
# systemd credential. The file must contain the restore database password with
# no leading/trailing whitespace.
# ASCENDANY_RESTORE_DATABASE_PASSWORD_FILE=/run/credentials/restore_db_password
