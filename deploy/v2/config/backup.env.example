# Non-secret backup configuration.
# `ascendany-backup.service` injects the fixed
# ASCENDANY_BACKUP_RUNTIME_ROOT=/run/ascendany-backup contract. Keep that
# runtime path out of this operator-editable file.
ASCENDANY_DATABASE_URL=postgresql://ascendany_backup_login@127.0.0.1:5432/ascendany_v2
ASCENDANY_ARTIFACT_ROOT=/var/lib/ascendany/artifacts
ASCENDANY_CATALOG_RECEIPT_ROOT=/var/lib/ascendany-catalog-publisher/receipts
ASCENDANY_BACKUP_ROOT=/var/backups/ascendany
ASCENDANY_BACKUP_FORMAT=pg_custom_plus_artifact_and_catalog_receipt_tar_zstd
ASCENDANY_BACKUP_MANIFEST_HASH=sha256
ASCENDANY_BACKUP_RETAIN_DAILY=14
ASCENDANY_BACKUP_RETAIN_WEEKLY=8
ASCENDANY_DATABASE_CONNECT_TIMEOUT=5s
ASCENDANY_BACKUP_COMMAND_TIMEOUT=2h
ASCENDANY_PG_DUMP_PATH=/usr/bin/pg_dump
ASCENDANY_PG_RESTORE_PATH=/usr/bin/pg_restore
ASCENDANY_ZSTD_PATH=/usr/bin/zstd
